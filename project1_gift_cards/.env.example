# ------------------------------------------------------------------
# OpenAI-compatible model endpoint configuration.
# COPY this file to `.env` in THIS folder and fill in YOUR values.
# `.env` is gitignored — never commit real keys.
# Each team member uses their own endpoint/key/model.
# ------------------------------------------------------------------

# Base URL of any OpenAI-compatible API (Anthropic-compatible gateways,
# DeepSeek, OpenAI, local servers, etc.). Must end in "/v1" typically.
OPENAI_BASE_URL=https://api.example.com/v1

# Your API key for that endpoint.
OPENAI_API_KEY=sk-your-key-here

# Default model used for the main classification pass.
OPENAI_MODEL=deepseek-chat

# Cheaper/faster model used for SMOKE tests (see AGENTS.md: cheap models first).
SMOKE_MODEL=deepseek-chat-mini

# How many reviews to classify in a default (stratified-sample) run.
SAMPLE_SIZE=3000

# Random seed for reproducible sampling.
RANDOM_SEED=42

# Max concurrent requests to the endpoint.
MAX_CONCURRENCY=8
